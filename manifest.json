{
  "manifest_version": 3,
  "name": "Send image to ComfyUI",
  "version": "1.3",
  "description": "一键将任意网页中的图片或视频当前帧发送到本地 ComfyUI 的 LoadImageOutput 节点，自动突破防盗链。视频帧内部解析提取（无播放器 UI，微博等直链视频同样支持），并自动裁剪黑边。",
  "permissions": [
    "activeTab",
    "scripting",
    "declarativeNetRequest",
    "declarativeNetRequestWithHostAccess",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true,
      "match_about_blank": true
    }
  ],
  "action": {
    "default_title": "ComfyUI Sender",
    "default_popup": "popup.html"
  }
}
